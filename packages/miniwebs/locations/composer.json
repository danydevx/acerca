    "type": "library",
    "license": "proprietary",
    "authors": [{"name": "MiniWebs Team"}],
    "require": {"php": "^8.2"},
    "autoload": {
        "psr-4": {
            "Modules\\Locations\\": "Modules/Locations/app/",
            "Modules\\ListingLocations\\": "Modules/ListingLocations/app/"
        }
    },
    "extra": {
